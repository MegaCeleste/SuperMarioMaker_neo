[gd_resource type="Resource" script_class="LiquidRules" format=3]

[ext_resource type="Script" path="res://scripts/level/liquid_rules.gd" id="1"]

[resource]
script = ExtResource("1")
water_sprite = &"spr_water"
beach_sprite = &"spr_water_b"
lava_sprite = &"spr_lava"
poison_sprite = &"spr_lava_purple"
