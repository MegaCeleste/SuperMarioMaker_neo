extends Node
## Builds [SpriteFrames] at runtime from the converted OpenWE sprite manifest.
##
## Converted sprites live under [code]assets/openwe/sprites/[/code] and are
## described by [code]assets/openwe/manifests/sprites.json[/code], which is
## generated by [code]tools/port_sprites.py[/code]. Keeping the metadata in a
## manifest avoids committing thousands of hand-generated [SpriteFrames]
## resources; entries are converted lazily and cached.

const MANIFEST_PATH := "res://assets/openwe/manifests/sprites.json"
const DEFAULT_ANIMATION := &"default"

var _sprites: Dictionary = {}
var _frames_cache: Dictionary = {}


func _ready() -> void:
	if not FileAccess.file_exists(MANIFEST_PATH):
		return
	var parsed: Variant = JSON.parse_string(
			FileAccess.get_file_as_string(MANIFEST_PATH))
	if parsed is Dictionary and parsed.get("sprites") is Dictionary:
		_sprites = parsed["sprites"]


func has_sprite(sprite_name: StringName) -> bool:
	return _sprites.has(String(sprite_name))


func get_metadata(sprite_name: StringName) -> Dictionary:
	return _sprites.get(String(sprite_name), {})


## Returns the sprite's origin in pixels, measured from the top-left corner.
func get_origin(sprite_name: StringName) -> Vector2:
	var origin: Array = get_metadata(sprite_name).get("origin", [0.0, 0.0])
	return Vector2(origin[0], origin[1])


## Returns a cached [SpriteFrames] for [param sprite_name], or an empty one if
## the sprite is not in the manifest.
func get_frames(sprite_name: StringName) -> SpriteFrames:
	var key := String(sprite_name)
	if _frames_cache.has(key):
		return _frames_cache[key]
	var entry := get_metadata(sprite_name)
	var frames := SpriteFrames.new()
	frames.set_animation_speed(DEFAULT_ANIMATION, float(entry.get("fps", 10.0)))
	frames.set_animation_loop(DEFAULT_ANIMATION, bool(entry.get("loop", true)))
	for path in entry.get("frames", []):
		var texture := load(path) as Texture2D
		if texture != null:
			frames.add_frame(DEFAULT_ANIMATION, texture)
	_frames_cache[key] = frames
	return frames


## Creates an [AnimatedSprite2D] positioned like a GameMaker instance: the
## sprite's origin (not its top-left corner) sits at the node position.
func make_sprite(sprite_name: StringName) -> AnimatedSprite2D:
	var sprite := AnimatedSprite2D.new()
	sprite.sprite_frames = get_frames(sprite_name)
	sprite.centered = false
	sprite.offset = -get_origin(sprite_name)
	sprite.play(DEFAULT_ANIMATION)
	return sprite
