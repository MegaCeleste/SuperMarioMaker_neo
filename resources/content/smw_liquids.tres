beach_fill_sprite = &"spr_water_beach_down"
lava_fill_sprite = &"spr_lava_down"
poison_fill_sprite = &"spr_lava_purple_down"
water_splash_sprite = &"spr_splash"
lava_splash_sprite = &"spr_splash_lava"
poison_splash_sprite = &"spr_splash_lava_purple"
