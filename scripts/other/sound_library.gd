class_name SoundLibrary
extends RefCounted
## Resolves converted OpenWE sounds by their source name, such as [code]snd_bump[/code].
##
## Converted audio lives under [code]assets/openwe/sounds/[/code], generated by
## [code]tools/porting/prepare_slice.py[/code] and never committed. Callers name a
## sound; only this file knows where and in which format it was converted.

const DIR := "res://assets/openwe/sounds/"
const EXTENSIONS := ["ogg", "wav"]
static var _paths: Dictionary = {}


## The resource path of a converted sound. A sound that was not converted keeps
## its .ogg path, so loading it reports the missing file by name.
static func path(sound: String) -> String:
	if not _paths.has(sound):
		_paths[sound] = DIR + sound + ".ogg"
		for extension in EXTENSIONS:
			if ResourceLoader.exists(DIR + sound + "." + extension):
				_paths[sound] = DIR + sound + "." + extension
				break
	return _paths[sound]


## The converted sound's stream, or null when it was not converted.
static func stream(sound: String) -> AudioStream:
	var resolved := path(sound)
	return load(resolved) as AudioStream if ResourceLoader.exists(resolved) else null
